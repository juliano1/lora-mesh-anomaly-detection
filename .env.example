# Copie para backend/.env (o backend lê .env do diretório em que é iniciado).
# Nunca versione valores reais.

# Obrigatória (>= 32 bytes). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Contas de bootstrap opcionais: senha de 12 a 72 bytes; vazio não cria a conta.
ADMIN100_PASSWORD=
ADMIN200_PASSWORD=

# API: loopback por padrão. Expor em outra interface exige TLS e controle de acesso à frente.
API_HOST=127.0.0.1
API_PORT=8000

# Broker MQTT local (scripts/docker-compose.yml publica só em 127.0.0.1).
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
NODE_TIMEOUT_SECONDS=240

# SQLite em backend/lora_mesh.db é o padrão. Para PostgreSQL (perfil requirements-postgres):
# DATABASE_URL=postgresql://<usuario>:<senha>@localhost:5432/lora_mesh

# LSTM-AE é o detector primário padrão (experimental) e exige o perfil
# backend/requirements-lstm.txt. Sem PyTorch, ou com false, o backend usa o Isolation Forest
# e registra o motivo (fallback_reason).
ML_LSTM_ENABLED=true
