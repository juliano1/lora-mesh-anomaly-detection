/*******************************************************************************
 * Credenciais do gateway (WiFi e MQTT) — modelo.
 *
 * 1. Copie este arquivo para credentials.h (ignorado pelo Git).
 * 2. Preencha com os valores da sua rede. Para CI e testes use apenas valores fictícios.
 *
 * O firmware usa MQTT sem TLS (porta 1883): use somente em rede de laboratório
 * isolada, com broker local autenticado. Não aponte para broker público.
 ******************************************************************************/

#ifndef _CREDENTIALS_H
#define _CREDENTIALS_H

// WiFi
#define WIFI_SSID           "YourSSID"
#define WIFI_PASSWORD       "YourPassword"

// Broker MQTT (endereço do computador que roda o Mosquitto na rede local)
#define MQTT_BROKER         "192.0.2.10"        // exemplo (RFC 5737); troque pelo seu
#define MQTT_PORT           1883
#define MQTT_USER           ""                  // usuário do gateway no broker (ver acl.example)
#define MQTT_PASSWORD       ""

#endif // _CREDENTIALS_H
